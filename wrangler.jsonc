{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animesfreak",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Optional: bind a D1 database later for real watchlist/progress
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "animesfreak", "database_id": "xxxx" }
  // ]
}
