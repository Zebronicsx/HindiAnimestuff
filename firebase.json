{
  "hosting": {
    "target": "hindianimestuff",
    "public": "output",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/assets/@(style|app|search|pagination|page-loader|notifications|tg-popup|favourites-page).@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
